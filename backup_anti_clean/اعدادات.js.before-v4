module.exports.config = {
  name: "اعدادات",
  version: "3.0.0",
  hasPermssion: 1,
  credits: "KIROS",
  description: "نظام حماية وإعدادات المجموعة",
  commandCategory: "الادمن",
  usages: "[1 2 3]",
  cooldowns: 2,
  usePrefix: true
};

module.exports.run = async function ({ api, event, Threads }) {
  const { threadID, messageID, senderID } = event;

  try {
    const threadData = await Threads.getData(threadID);
    const data = threadData?.data || {};

    /*
     * الإعدادات الافتراضية
     */
    if (!data.antiSettings) {
      data.antiSettings = {
        antiSpam: false,
        antiName: false,
        antiImage: false,
        antiNickname: false,
        notifications: true
      };
    }

    const s = data.antiSettings;

    /*
     * القائمة
     */
    const menu =
`╭─❖ [ إعدادات الحماية ] ❖─╮
│
│ 🛡️ نظام حماية المجموعة
│
│ 1. مكافحة الإزعاج      ${s.antiSpam ? "▣" : "□"}
│ 2. حماية اسم المجموعة  ${s.antiName ? "▣" : "□"}
│ 3. حماية صورة المجموعة ${s.antiImage ? "▣" : "□"}
│ 4. حماية الكنية         ${s.antiNickname ? "▣" : "□"}
│ 5. الإشعارات            ${s.notifications ? "▣" : "□"}
│
╰──────────────────────╯

╭─❖ [ الحالة الحالية ] ❖─╮
│
│ 1️⃣ الإزعاج: ${s.antiSpam ? "مفعل" : "متوقف"}
│ 2️⃣ الاسم: ${s.antiName ? "مفعل" : "متوقف"}
│ 3️⃣ الصورة: ${s.antiImage ? "مفعل" : "متوقف"}
│ 4️⃣ الكنية: ${s.antiNickname ? "مفعل" : "متوقف"}
│ 5️⃣ الإشعارات: ${s.notifications ? "مفعل" : "متوقف"}
│
╰──────────────────────╯

⌲ أرسل الأرقام المطلوبة
⌲ مثال: 1 3 5
⌲ أو: 1⇣3⇣5

╭─❖ [ ملاحظة ] ❖─╮
│ حماية الصورة والكنية
│ تحتاج أن يكون البوت أدمن.
╰──────────────────╯`;

    api.sendMessage(
      menu,
      threadID,
      (err, info) => {
        if (err || !info) {
          console.error("[اعدادات] Send menu error:", err);
          return;
        }

        if (!global.client.handleReply) {
          global.client.handleReply = [];
        }

        global.client.handleReply.push({
          name: "اعدادات",
          messageID: info.messageID,
          author: senderID,
          settings: { ...s }
        });
      },
      messageID
    );

  } catch (error) {
    console.error("[اعدادات] Error:", error);

    return api.sendMessage(
      "❌ حدث خطأ أثناء تحميل إعدادات المجموعة.",
      threadID
    );
  }
};


module.exports.handleReply = async function ({
  api,
  event,
  handleReply
}) {
  const {
    threadID,
    body,
    senderID,
    messageID
  } = event;

  /*
   * صاحب القائمة فقط يستطيع تعديلها
   */
  if (String(senderID) !== String(handleReply.author)) {
    return;
  }

  const choices = String(body || "").match(/\d+/g);

  if (!choices) {
    return api.sendMessage(
      `╭─❖ [ خطأ ] ❖─╮
│
│ ❌ لم أجد أرقاماً صحيحة.
│
│ مثال:
│ 1 3 5
│
╰────────────────╯`,
      threadID,
      null,
      messageID
    );
  }

  /*
   * نسخة جديدة حتى لا نعدّل الكائن
   * الموجود داخل handleReply مباشرة
   */
  const s = {
    ...handleReply.settings
  };

  for (const num of choices) {
    switch (num) {

      case "1":
        s.antiSpam = !s.antiSpam;
        break;

      case "2":
        s.antiName = !s.antiName;
        break;

      case "3":
        s.antiImage = !s.antiImage;
        break;

      case "4":
        s.antiNickname = !s.antiNickname;
        break;

      case "5":
        s.notifications = !s.notifications;
        break;
    }
  }

  const confirmation =
`╭─❖ [ تأكيد التغييرات ] ❖─╮
│
│ 🛡️ الإعدادات الجديدة
│
│ 1️⃣ الإزعاج: ${s.antiSpam ? "مفعل" : "متوقف"}
│ 2️⃣ الاسم: ${s.antiName ? "مفعل" : "متوقف"}
│ 3️⃣ الصورة: ${s.antiImage ? "مفعل" : "متوقف"}
│ 4️⃣ الكنية: ${s.antiNickname ? "مفعل" : "متوقف"}
│ 5️⃣ الإشعارات: ${s.notifications ? "مفعل" : "متوقف"}
│
╰──────────────────────╯

👍 تفاعل بـ 👍 لتثبيت التغييرات.
`;

  api.sendMessage(
    confirmation,
    threadID,
    (err, info) => {
      if (err || !info) {
        console.error("[اعدادات] Confirmation error:", err);
        return;
      }

      if (!global.client.handleReaction) {
        global.client.handleReaction = [];
      }

      global.client.handleReaction.push({
        name: "اعدادات",
        messageID: info.messageID,
        author: senderID,
        newSettings: s
      });
    },
    messageID
  );
};


module.exports.handleReaction = async function ({
  api,
  event,
  handleReaction,
  Threads
}) {
  const {
    threadID,
    reaction,
    userID
  } = event;

  /*
   * الشخص الذي فتح القائمة فقط
   */
  if (
    String(userID) !==
    String(handleReaction.author)
  ) {
    return;
  }

  if (reaction !== "👍") {
    return;
  }

  try {

    /*
     * معلومات المجموعة
     */
    const threadInfo =
      await api.getThreadInfo(threadID);

    const botID =
      api.getCurrentUserID();

    const adminIDs =
      Array.isArray(threadInfo.adminIDs)
        ? threadInfo.adminIDs
        : [];

    const isAdmin =
      adminIDs.some(
        item =>
          String(item.id) ===
          String(botID)
      );

    const finalSettings = {
      ...handleReaction.newSettings
    };

    let warning = "";

    /*
     * حماية الصورة والكنية تحتاج البوت يكون أدمن
     */
    if (!isAdmin) {

      if (
        finalSettings.antiImage ||
        finalSettings.antiNickname
      ) {

        finalSettings.antiImage = false;
        finalSettings.antiNickname = false;

        warning =
`\n\n⚠️ تنبيه:
البوت ليس أدمن في المجموعة.

تم تعطيل:
• حماية الصورة
• حماية الكنية`;
      }
    }

    /*
     * قراءة البيانات الحالية
     */
    const current =
      await Threads.getData(threadID);

    const data =
      current?.data || {};

    /*
     * حفظ الإعدادات
     */
    data.antiSettings =
      finalSettings;

    /*
     * حفظ Snapshot جديد
     *
     * مهم:
     * نلتقط البيانات الحالية وقت حفظ
     * الإعدادات، وليس من حدث قديم.
     */
    data.snapshot = {
      name:
        threadInfo.threadName || "",

      imageSrc:
        threadInfo.imageSrc || "",

      nicknames:
        threadInfo.nicknames || {}
    };

    /*
     * متغيرات داخلية للحماية
     */
    data.antiProtection = {
      imageRestoring: false,
      lastImageRestore: 0
    };

    /*
     * تهيئة Anti Spam
     */
    if (!data.spamTracking) {
      data.spamTracking = {};
    }

    await Threads.setData(
      threadID,
      { data }
    );

    const confirm =
`╭─❖ [ تم الحفظ ] ❖─╮
│
│ ✅ تم تحديث إعدادات المجموعة
│
│ 🛡️ نظام الحماية جاهز
│
╰──────────────────╯${warning}`;

    return api.sendMessage(
      confirm,
      threadID
    );

  } catch (error) {

    console.error(
      "[اعدادات] Save Error:",
      error
    );

    return api.sendMessage(
      `╭─❖ [ خطأ ] ❖─╮
│
│ ❌ تعذر حفظ الإعدادات.
│
│ ${error.message || "خطأ غير معروف"}
│
╰────────────────╯`,
      threadID
    );
  }
};
