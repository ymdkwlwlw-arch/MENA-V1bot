module.exports.config = {
  name: "leave",
  eventType: ["log:unsubscribe"],
  version: "2.1.0",
  credits: "Mirai Team | تعديل: محمد إدريس",
  description: "إشعار مغادرة أو طرد الأعضاء",
  dependencies: {}
};

module.exports.run = async function({ api, event, Users }) {
  const { threadID } = event;

  console.log("\n========== [LEAVE EVENT] ==========");
  console.log(JSON.stringify(event, null, 2));
  console.log("===================================\n");

  const data = event.logMessageData || {};
  const leftID =
    data.leftParticipantFbId ||
    data.leftParticipantFbIds?.[0];

  if (!leftID) {
    console.log("[leave] لم يتم العثور على leftParticipantFbId");
    return;
  }

  try {
    let name = global.data.userName.get(String(leftID));

    if (!name) {
      try {
        name = await Users.getNameUser(String(leftID));
      } catch (e) {
        name = "العضو";
      }
    }

    name = name || "العضو";

    const authorID = String(event.author || "");
    const memberID = String(leftID);

    const leftBySelf = authorID === memberID;

    console.log("[leave] العضو:", memberID);
    console.log("[leave] المنفذ:", authorID);
    console.log("[leave] خرج بنفسه:", leftBySelf);

    // شخص آخر قام بطرده
    if (!leftBySelf) {
      return api.sendMessage(
        "بلع في خمستو 🦧",
        threadID
      );
    }

    // العضو خرج بنفسه
    try {
      if (typeof api.addUserToGroup !== "function") {
        console.log("[leave] addUserToGroup غير موجود في API");
        
        return api.sendMessage(
          "هو انت فطرت عشان تطلع بي كرامتك 🗿",
          threadID
        );
      }

      await api.addUserToGroup(memberID, threadID);

      return api.sendMessage(
        "هو انت فطرت عشان تطلع بي كرامتك 🗿",
        threadID
      );

    } catch (error) {
      console.log(
        `[leave] فشل إرجاع ${name}:`,
        error
      );

      return api.sendMessage(
        "العب اوسخ من انو ينضاف 🐸",
        threadID
      );
    }

  } catch (error) {
    console.log("[leave] Error:", error);
  }
};
