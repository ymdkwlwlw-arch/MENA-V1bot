module.exports.config = {
  name: "leave",
  eventType: ["log:unsubscribe"],
  version: "2.0.0",
  credits: "Mirai Team | تعديل: محمد إدريس",
  description: "إشعار مغادرة أو طرد الأعضاء",
  dependencies: {}
};

module.exports.run = async function({ api, event, Users }) {
  const { threadID } = event;
  const leftID = event.logMessageData?.leftParticipantFbId;

  if (!leftID) {
    return;
  }

  try {
    let name = global.data.userName.get(leftID);

    if (!name) {
      try {
        name = await Users.getNameUser(leftID);
      } catch (e) {
        name = "العضو";
      }
    }

    name = name || "العضو";

    /*
     * إذا كان العضو نفسه هو صاحب الحدث
     * فهذا يعني أنه غادر بنفسه.
     *
     * إذا كان event.author مختلفًا عنه
     * فهذا يعني أن شخصًا آخر قام بإزالته.
     */

    const leftBySelf = String(event.author) === String(leftID);

    // ═══════════════════════════════
    // 🦧 تم طرده بواسطة الأدمن
    // ═══════════════════════════════

    if (!leftBySelf) {
      return api.sendMessage(
        `بلع في خمستو 🦧`,
        threadID
      );
    }

    // ═══════════════════════════════
    // 🗿 العضو غادر بنفسه
    // ═══════════════════════════════

    try {

      // محاولة إعادة العضو
      await api.addUserToGroup(leftID, threadID);

      return api.sendMessage(
        `هو انت فطرت عشان تطلع بي كرامتك 🗿`,
        threadID
      );

    } catch (error) {

      console.log(
        `[leave] فشل إرجاع ${name}:`,
        error.message
      );

      return api.sendMessage(
        `العب اوسخ من انو ينضاف 🐸`,
        threadID
      );
    }

  } catch (error) {

    console.log("[leave] Error:", error);

  }
};
