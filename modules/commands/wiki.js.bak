const axios = require("axios");

module.exports.config = {
    name: "ويكي",
    aliases: ["wiki", "ويكيبيديا"],
    version: "1.0.0",
    hasPermssion: 0,
    credits: "KIROS",
    description: "البحث في ويكيبيديا وإظهار ملخص المقال",
    commandCategory: "المعلومات",
    usages: "ويكي [موضوع البحث]",
    cooldowns: 3,
    usePrefix: true
};

module.exports.run = async function ({ api, event, args }) {
    const { threadID, messageID } = event;
    const query = args.join(" ").trim();

    if (!query) {
        return api.sendMessage(
            "╭─❖ [ ويكيبيديا ] ❖─╮\n\n" +
            "⚠️ اكتب موضوع البحث.\n\n" +
            "📝 مثال:\n" +
            "╰─◗ /ويكي السودان\n\n" +
            "╰───────────────╯",
            threadID,
            messageID
        );
    }

    try {
        await api.setMessageReaction(
            "🔎",
            messageID,
            threadID
        );
    } catch (e) {}

    try {
        const search = await axios.get(
            "https://ar.wikipedia.org/w/api.php",
            {
                params: {
                    action: "query",
                    list: "search",
                    srsearch: query,
                    srlimit: 1,
                    format: "json",
                    utf8: 1
                },
                headers: {
                    "User-Agent": "KIROS-Bot/1.0"
                },
                timeout: 15000
            }
        );

        const results =
            search.data?.query?.search || [];

        if (!results.length) {
            try {
                await api.setMessageReaction(
                    "❌",
                    messageID,
                    threadID
                );
            } catch (e) {}

            return api.sendMessage(
                "╭─❖ [ ويكيبيديا ] ❖─╮\n\n" +
                `❌ لم أجد نتيجة عن: ${query}\n\n` +
                "╰───────────────╯",
                threadID,
                messageID
            );
        }

        const title = results[0].title;

        const page = await axios.get(
            "https://ar.wikipedia.org/api/rest_v1/page/summary/" +
            encodeURIComponent(title),
            {
                headers: {
                    "User-Agent": "KIROS-Bot/1.0"
                },
                timeout: 15000
            }
        );

        const data = page.data;

        const description =
            data.description ||
            "لا يوجد وصف مختصر.";

        let extract =
            data.extract ||
            "لا يوجد ملخص متاح.";

        if (extract.length > 1800) {
            extract =
                extract.slice(0, 1800) + "...";
        }

        const articleUrl =
            data.content_urls?.desktop?.page ||
            `https://ar.wikipedia.org/wiki/${encodeURIComponent(title)}`;

        try {
            await api.setMessageReaction(
                "📚",
                messageID,
                threadID
            );
        } catch (e) {}

        return api.sendMessage(
            "╭─❖ [ ويكيبيديا ] ❖─╮\n\n" +
            `📌 ${title}\n` +
            `🏷️ ${description}\n\n` +
            `${extract}\n\n` +
            `🔗 ${articleUrl}\n\n` +
            "╰───────────────╯",
            threadID,
            messageID
        );

    } catch (error) {

        console.log(
            "[WIKI] ERROR:",
            error.message
        );

        try {
            await api.setMessageReaction(
                "❌",
                messageID,
                threadID
            );
        } catch (e) {}

        return api.sendMessage(
            "╭─❖ [ ويكيبيديا ] ❖─╮\n\n" +
            "❌ حصل خطأ أثناء الاتصال بويكيبيديا.\n" +
            "جرّب مرة ثانية بعد قليل.\n\n" +
            "╰───────────────╯",
            threadID,
            messageID
        );
    }
};
