const axios = require("axios");
const fs = require("fs-extra");
const path = require("path");
const ytdl = require("@distube/ytdl-core");

module.exports.config = {
    name: "تحميل",
    aliases: ["download", "dl"],
    version: "2.2.0",
    hasPermssion: 0,
    credits: "ڪولو سآن",
    description: "تحميل فيديو من يوتيوب أو رابط مباشر",
    commandCategory: "التحميل",
    usages: "تحميل <الرابط>",
    cooldowns: 10,
    usePrefix: true
};

const CACHE_DIR = path.join(__dirname, "cache");

async function downloadDirect(url, output) {
    const response = await axios({
        method: "GET",
        url,
        responseType: "arraybuffer",
        timeout: 60000,
        maxRedirects: 5,
        headers: {
            "User-Agent": "Mozilla/5.0"
        }
    });

    await fs.writeFile(output, Buffer.from(response.data));
}

async function downloadYouTube(url, output) {
    return new Promise((resolve, reject) => {
        const stream = ytdl(url, {
            quality: "18",
            filter: "audioandvideo",
            highWaterMark: 1 << 25
        });

        const chunks = [];

        stream.on("data", chunk => {
            chunks.push(chunk);
        });

        stream.on("end", async () => {
            try {
                const buffer = Buffer.concat(chunks);
                await fs.writeFile(output, buffer);
                resolve();
            } catch (error) {
                reject(error);
            }
        });

        stream.on("error", reject);
    });
}

module.exports.run = async function ({ api, event, args }) {
    const threadID = event.threadID;
    const messageID = event.messageID;

    const url = args && args[0];

    if (!url) {
        return api.sendMessage(
            "استخدم الأمر بهذا الشكل:\n/تحميل رابط",
            threadID,
            messageID
        );
    }

    if (!/^https?:\/\//i.test(url)) {
        return api.sendMessage(
            "الرابط غير صالح.",
            threadID,
            messageID
        );
    }

    await fs.ensureDir(CACHE_DIR);

    const file = path.join(
        CACHE_DIR,
        `video_${Date.now()}.mp4`
    );

    try {
        const isYouTube =
            ytdl.validateURL(url) ||
            /(^|\.)youtube\.com|youtu\.be/i.test(url);

        if (isYouTube) {
            await downloadYouTube(url, file);
        } else {
            await downloadDirect(url, file);
        }

        if (!(await fs.pathExists(file))) {
            throw new Error("FILE_NOT_FOUND");
        }

        const stat = await fs.stat(file);

        if (!stat.size) {
            throw new Error("EMPTY_FILE");
        }

        const MAX_SIZE = 24 * 1024 * 1024;

        if (stat.size > MAX_SIZE) {
            await fs.remove(file);

            return api.sendMessage(
                "الفيديو أكبر من الحجم المسموح للإرسال.",
                threadID,
                messageID
            );
        }

        console.log(
            `[تحميل] Video ready: ${(stat.size / 1024 / 1024).toFixed(2)} MB`
        );

        /*
         * نقرأ الملف كاملاً قبل الإرسال
         * لتجنب مشكلة uploadAttachment مع stream.
         */
        const videoBuffer = await fs.readFile(file);

        console.log(
            `[تحميل] Sending ${videoBuffer.length} bytes...`
        );

        return api.sendMessage(
            {
                body:
                    "╭─── ◸ تـحـمـيـل ◿ ───╮\n" +
                    "│ تم تحميل الفيديو بنجاح.\n" +
                    "│ الحجم: " +
                    (stat.size / 1024 / 1024).toFixed(2) +
                    " MB\n" +
                    "╰──────────────────╯",

                attachment: videoBuffer
            },
            threadID,
            (err) => {
                fs.remove(file).catch(() => {});

                if (err) {
                    console.error(
                        "[تحميل] Send Error:",
                        err
                    );
                } else {
                    console.log(
                        "[تحميل] Video sent successfully."
                    );
                }
            },
            messageID
        );

    } catch (error) {
        await fs.remove(file).catch(() => {});

        console.error(
            "[تحميل] Error:",
            error.message
        );

        return api.sendMessage(
            "تعذر إرسال الفيديو حالياً.",
            threadID,
            messageID
        );
    }
};
