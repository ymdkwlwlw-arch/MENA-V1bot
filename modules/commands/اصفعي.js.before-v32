const axios = require("axios");
const fs = require("fs-extra");
const path = require("path");
const { spawn } = require("child_process");

module.exports.config = {
    name: "اصفعي",
    aliases: ["صفعة", "صفع", "slap"],
    version: "3.1.0",
    hasPermssion: 0,
    credits: "ڪولو سآن",
    description: "صفع العضو المحدد مع تأثير بصري",
    commandCategory: "ترفيه",
    usages: "اصفعي @منشن أو بالرد",
    cooldowns: 5,
    usePrefix: true
};

const CACHE_DIR = path.join(__dirname, "cache");
const FFMPEG = "ffmpeg";

const USER_AGENT =
    "Mozilla/5.0 (Linux; Android 16) AppleWebKit/537.36 Chrome/140 Mobile Safari/537.36";

/* =========================
   Reaction
========================= */

function safeReaction(api, reaction, messageID, threadID) {
    return new Promise((resolve) => {
        if (!api || !reaction || !messageID || !threadID) {
            return resolve(false);
        }

        try {
            api.setMessageReaction(
                reaction,
                messageID,
                threadID,
                () => resolve(true)
            );
        } catch (error) {
            resolve(false);
        }
    });
}

/* =========================
   Download
========================= */

async function downloadFile(url, output) {
    const response = await axios({
        method: "GET",
        url,
        responseType: "arraybuffer",
        timeout: 30000,
        maxRedirects: 10,
        headers: {
            "User-Agent": USER_AGENT,
            "Accept": "*/*"
        }
    });

    if (!response.data || !response.data.length) {
        throw new Error("الملف المستلم فارغ.");
    }

    await fs.outputFile(output, response.data);

    const stat = await fs.stat(output);

    if (!stat.size) {
        throw new Error("فشل حفظ الملف.");
    }

    return output;
}

/* =========================
   Facebook Avatar
========================= */

async function getAvatar(uid, output) {
    const url =
        `https://graph.facebook.com/${uid}/picture?width=720&height=720`;

    return downloadFile(url, output);
}

/* =========================
   Slap API
========================= */

async function getSlapURL() {
    const response = await axios.get(
        "https://nekos.best/api/v2/slap",
        {
            timeout: 20000,
            headers: {
                "User-Agent": USER_AGENT,
                "Accept": "application/json"
            }
        }
    );

    if (
        !response.data ||
        !Array.isArray(response.data.results) ||
        !response.data.results.length ||
        !response.data.results[0].url
    ) {
        throw new Error("API لم يرجع تأثير صفعة.");
    }

    return response.data.results[0].url;
}

/* =========================
   FFmpeg Runner
========================= */

function runFFmpeg(args) {
    return new Promise((resolve, reject) => {
        const child = spawn(FFMPEG, args);

        let stderr = "";

        child.stderr.on("data", (data) => {
            stderr += data.toString();
        });

        child.on("error", (error) => {
            reject(error);
        });

        child.on("close", (code) => {
            if (code === 0) {
                resolve();
                return;
            }

            reject(
                new Error(
                    `FFmpeg failed (${code})\n${stderr.slice(-5000)}`
                )
            );
        });
    });
}

/* =========================
   GIF -> PNG
========================= */

async function gifToPng(gifFile, pngFile) {
    await runFFmpeg([
        "-y",
        "-i",
        gifFile,
        "-frames:v",
        "1",
        "-vf",
        "format=rgba",
        pngFile
    ]);

    if (!(await fs.pathExists(pngFile))) {
        throw new Error("فشل تحويل تأثير الصفعة إلى PNG.");
    }

    const stat = await fs.stat(pngFile);

    if (!stat.size) {
        throw new Error("ملف التأثير PNG فارغ.");
    }

    return pngFile;
}

/* =========================
   Compose
========================= */

async function composeSlap(avatar, effect, output) {
    await runFFmpeg([
        "-y",

        "-i",
        avatar,

        "-i",
        effect,

        "-filter_complex",

        "[0:v]" +
        "scale=720:720:force_original_aspect_ratio=increase," +
        "crop=720:720," +
        "setsar=1[base];" +

        "[1:v]" +
        "scale=720:-1:force_original_aspect_ratio=decrease," +
        "format=rgba," +
        "setsar=1[effect];" +

        "[base][effect]" +
        "overlay=(W-w)/2:(H-h)/2:format=auto," +
        "format=yuv420p[out]",

        "-map",
        "[out]",

        "-frames:v",
        "1",

        "-q:v",
        "3",

        output
    ]);

    if (!(await fs.pathExists(output))) {
        throw new Error("FFmpeg لم ينشئ الصورة النهائية.");
    }

    const stat = await fs.stat(output);

    if (!stat.size) {
        throw new Error("الصورة النهائية فارغة.");
    }

    return output;
}

/* =========================
   Target
========================= */

function getTargetID(event) {
    if (
        event.messageReply &&
        event.messageReply.senderID
    ) {
        return event.messageReply.senderID;
    }

    if (
        event.mentions &&
        Object.keys(event.mentions).length
    ) {
        return Object.keys(event.mentions)[0];
    }

    return null;
}

/* =========================
   Command
========================= */

module.exports.run = async function ({ api, event }) {
    const {
        threadID,
        messageID
    } = event;

    const targetID = getTargetID(event);

    if (!targetID) {
        return api.sendMessage(
            "رد على رسالة الشخص أو اعمل له منشن.",
            threadID,
            messageID
        );
    }

    await fs.ensureDir(CACHE_DIR);

    const id = `${targetID}_${Date.now()}`;

    const avatarFile = path.join(
        CACHE_DIR,
        `slap_avatar_${id}.jpg`
    );

    const gifFile = path.join(
        CACHE_DIR,
        `slap_effect_${id}.gif`
    );

    const pngFile = path.join(
        CACHE_DIR,
        `slap_effect_${id}.png`
    );

    const outputFile = path.join(
        CACHE_DIR,
        `slap_result_${id}.jpg`
    );

    try {
        await safeReaction(
            api,
            "⏳",
            messageID,
            threadID
        );

        /*
         * 1 ـ صورة المستخدم
         */

        await getAvatar(
            targetID,
            avatarFile
        );

        /*
         * 2 ـ رابط تأثير الصفعة
         */

        const slapURL = await getSlapURL();

        /*
         * 3 ـ تحميل GIF
         */

        await downloadFile(
            slapURL,
            gifFile
        );

        /*
         * 4 ـ GIF إلى PNG
         */

        await gifToPng(
            gifFile,
            pngFile
        );

        /*
         * 5 ـ دمج الصورتين
         */

        await composeSlap(
            avatarFile,
            pngFile,
            outputFile
        );

        /*
         * نجاح
         */

        await safeReaction(
            api,
            "✅",
            messageID,
            threadID
        );

        return api.sendMessage(
            {
                body:
                    "╭─── ◸ صَفْعَة ◿ ───╮\n" +
                    "│ تم تنفيذ الصفعة بنجاح.\n" +
                    "│ ◉ الصورة: جاهزة\n" +
                    "│ ◉ التأثير: مضاف\n" +
                    "╰──────────────────╯",

                attachment:
                    fs.createReadStream(outputFile)
            },

            threadID,

            () => {
                Promise.all([
                    fs.remove(avatarFile).catch(() => {}),
                    fs.remove(gifFile).catch(() => {}),
                    fs.remove(pngFile).catch(() => {}),
                    fs.remove(outputFile).catch(() => {})
                ]);
            },

            messageID
        );

    } catch (error) {

        console.error(
            "\n[ اصفعي V3.1 ERROR ]\n",
            error
        );

        await Promise.all([
            fs.remove(avatarFile).catch(() => {}),
            fs.remove(gifFile).catch(() => {}),
            fs.remove(pngFile).catch(() => {}),
            fs.remove(outputFile).catch(() => {})
        ]);

        await safeReaction(
            api,
            "❌",
            messageID,
            threadID
        );

        return api.sendMessage(
            "تعذر تنفيذ تأثير الصفعة حالياً.",
            threadID,
            messageID
        );
    }
};
