const axios = require("axios");
const fs = require("fs-extra");
const path = require("path");
const { spawn } = require("child_process");

module.exports.config = {
    name: "اصفعي",
    aliases: ["صفعة", "صفع", "slap"],
    version: "3.3.0",
    hasPermssion: 0,
    credits: "ڪولو سآن",
    description: "إرسال صورة العضو مع تأثير صفعة",
    commandCategory: "ترفيه",
    usages: "اصفعي @منشن أو بالرد",
    cooldowns: 5,
    usePrefix: true
};

const CACHE_DIR = path.join(__dirname, "cache");

async function safeReaction(api, reaction, messageID, threadID) {
    return new Promise((resolve) => {
        if (!api || !reaction || !messageID || !threadID) {
            return resolve(false);
        }

        try {
            api.setMessageReaction(
                reaction,
                messageID,
                threadID,
                () => resolve(true)
            );
        } catch (error) {
            resolve(false);
        }
    });
}

/* تحميل صورة البروفايل */
async function getAvatar(uid, output) {
    const url =
        `https://graph.facebook.com/${uid}/picture?width=720&height=720`;

    const response = await axios.get(url, {
        responseType: "arraybuffer",
        timeout: 30000,
        maxRedirects: 10,
        headers: {
            "User-Agent":
                "Mozilla/5.0 (Linux; Android 13) AppleWebKit/537.36 Chrome/120 Safari/537.36",
            "Accept": "image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8"
        }
    });

    if (!response.data || !response.data.length) {
        throw new Error("Avatar response is empty");
    }

    await fs.outputFile(output, response.data);

    const stat = await fs.stat(output);

    if (!stat.size) {
        throw new Error("Avatar file is empty");
    }

    return output;
}

/* جلب رابط تأثير الصفعة */
async function getSlapURL() {
    const apiURL = "https://nekos.best/api/v2/slap";

    const headers = {
        "User-Agent": "MENA-V1bot/1.0 (https://github.com/ymdkwlwlw-arch/MENA-V1bot)",
        "Accept": "application/json",
        "Accept-Language": "en-US,en;q=0.9",
        "Referer": "https://nekos.best/",
        "Connection": "keep-alive"
    };

    let response;

    try {
        response = await axios.get(apiURL, {
            timeout: 30000,
            maxRedirects: 5,
            headers
        });
    } catch (error) {
        const status = error.response?.status;

        throw new Error(
            `NEKOSBEST_REQUEST_FAILED: ${status || error.code || error.message}`
        );
    }

    const data = response.data;

    if (
        !data ||
        !Array.isArray(data.results) ||
        !data.results.length
    ) {
        throw new Error(
            "NEKOSBEST_INVALID_RESPONSE: " +
            JSON.stringify(data).slice(0, 500)
        );
    }

    const result = data.results[0];

    if (!result.url) {
        throw new Error("NEKOSBEST_NO_GIF_URL");
    }

    return result.url;
}

/* تحميل ملف التأثير */
async function downloadFile(url, output) {
    const response = await axios.get(url, {
        responseType: "arraybuffer",
        timeout: 60000,
        maxRedirects: 10,
        headers: {
            "User-Agent": "Mozilla/5.0",
            "Accept": "*/*"
        }
    });

    if (!response.data || !response.data.length) {
        throw new Error("Downloaded effect is empty");
    }

    await fs.outputFile(output, response.data);

    const stat = await fs.stat(output);

    if (!stat.size) {
        throw new Error("Downloaded effect file is empty");
    }

    return output;
}

/* تشغيل FFmpeg */
function runFFmpeg(args) {
    return new Promise((resolve, reject) => {
        const ffmpeg = spawn("ffmpeg", args);

        let stderr = "";

        ffmpeg.stderr.on("data", (data) => {
            stderr += data.toString();
        });

        ffmpeg.on("error", (error) => {
            reject(error);
        });

        ffmpeg.on("close", (code) => {
            if (code === 0) {
                resolve();
            } else {
                reject(
                    new Error(
                        `FFmpeg exited with code ${code}\n${stderr.slice(-5000)}`
                    )
                );
            }
        });
    });
}

/* GIF → PNG */
async function extractEffectFrame(gifFile, pngFile) {
    await runFFmpeg([
        "-y",
        "-i",
        gifFile,
        "-ss",
        "0.7",
        "-frames:v",
        "1",
        "-vf",
        "format=rgba",
        "-update",
        "1",
        pngFile
    ]);

    if (!(await fs.pathExists(pngFile))) {
        throw new Error("Effect PNG was not created");
    }

    return pngFile;
}

/* دمج الصورة مع تأثير الصفعة */
async function createSlap(avatar, effect, output) {
    await runFFmpeg([
        "-y",

        "-i",
        avatar,
        "-i",
        effect,

        "-filter_complex",

        "[0:v]" +
        "scale=720:720:force_original_aspect_ratio=increase," +
        "crop=720:720," +
        "setsar=1," +
        "format=rgba" +
        "[base];" +

        "[1:v]" +
        "scale=720:-1:force_original_aspect_ratio=decrease," +
        "setsar=1," +
        "format=rgba" +
        "[fx];" +

        "[base][fx]" +
        "overlay=(W-w)/2:(H-h)/2:format=auto," +
        "format=yuv420p" +
        "[out]",

        "-map",
        "[out]",

        "-frames:v",
        "1",

        "-q:v",
        "3",

        "-update",
        "1",

        output
    ]);

    if (!(await fs.pathExists(output))) {
        throw new Error("Final image was not created");
    }

    const stat = await fs.stat(output);

    if (!stat.size) {
        throw new Error("Final image is empty");
    }

    return output;
}

async function cleanup(files) {
    for (const file of files) {
        try {
            await fs.remove(file);
        } catch {}
    }
}

module.exports.run = async function ({ api, event }) {
    const {
        threadID,
        messageID,
        messageReply,
        mentions
    } = event;

    let targetID = null;

    /* الرد أولاً */
    if (messageReply && messageReply.senderID) {
        targetID = messageReply.senderID;
    }

    /* ثم المنشن */
    if (!targetID && mentions && Object.keys(mentions).length) {
        targetID = Object.keys(mentions)[0];
    }

    if (!targetID) {
        return api.sendMessage(
            "رد على رسالة الشخص أو اعمل له منشن.",
            threadID,
            messageID
        );
    }

    await fs.ensureDir(CACHE_DIR);

    const stamp = `${targetID}_${Date.now()}`;

    const avatarFile = path.join(
        CACHE_DIR,
        `slap_avatar_${stamp}.jpg`
    );

    const gifFile = path.join(
        CACHE_DIR,
        `slap_effect_${stamp}.gif`
    );

    const effectFile = path.join(
        CACHE_DIR,
        `slap_effect_${stamp}.png`
    );

    const finalFile = path.join(
        CACHE_DIR,
        `slap_final_${stamp}.jpg`
    );

    const files = [
        avatarFile,
        gifFile,
        effectFile,
        finalFile
    ];

    try {
        await safeReaction(
            api,
            "⏳",
            messageID,
            threadID
        );

        /* 1 — تحميل الصورة */
        await getAvatar(
            targetID,
            avatarFile
        );

        /* 2 — الحصول على تأثير */
        const slapURL = await getSlapURL();

        /* 3 — تحميل GIF */
        await downloadFile(
            slapURL,
            gifFile
        );

        /* 4 — استخراج الإطار */
        await extractEffectFrame(
            gifFile,
            effectFile
        );

        /* 5 — الدمج */
        await createSlap(
            avatarFile,
            effectFile,
            finalFile
        );

        await safeReaction(
            api,
            "✅",
            messageID,
            threadID
        );

        return api.sendMessage(
            {
                body:
                    "╭─── ◸ صَفْعَة ◿ ───╮\n" +
                    "│ تم تنفيذ الصفعة.\n" +
                    "│ ◉ الهدف: تم تحديده\n" +
                    "│ ◉ التأثير: تم تطبيقه\n" +
                    "╰──────────────────╯",

                attachment: fs.createReadStream(finalFile)
            },

            threadID,

            () => {
                cleanup(files);
            },

            messageID
        );

    } catch (error) {

        await cleanup(files);

        console.error(
            "\n╭─── ◸ اصفعي V3.3 ERROR ◿ ───╮"
        );

        console.error(
            error?.stack ||
            error?.message ||
            error
        );

        console.error(
            "╰────────────────────────────╯\n"
        );

        return api.sendMessage(
            "تعذر تنفيذ تأثير الصفعة حالياً.",
            threadID,
            messageID
        );
    }
};
